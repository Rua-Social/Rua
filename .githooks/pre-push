#!/bin/sh
# Rua pre-push hook. Blocks a direct push to main. Runs tool tests when
# html-to-pdf, rua-desk, rua-vault, or rua-seat are in the push.
#
# Install:
#   git config core.hooksPath .githooks
#
# Bypass once, deliberately and visibly:
#   git push --no-verify
#
# This is a local hard stop. It protects you from habit, not from intent.
# Branch protection on the remote is the layer that actually holds.

protected="main"
zero="0000000000000000000000000000000000000000"
run_tools_check=0
root=$(git rev-parse --show-toplevel)

while read -r _local_ref local_sha remote_ref remote_sha; do
  branch="${remote_ref#refs/heads/}"
  if [ "$branch" = "$protected" ]; then
    cat >&2 <<'MSG'

  Push to main blocked.

  Work happens on a branch and lands through a pull request.
  Doctrine: 00-system/skills/rua-git-flow/

    git switch -c feat/your-change
    git push -u origin feat/your-change
    gh pr create --fill

  If this is genuinely a typo or a date, and you accept there will be no
  diff review, bypass deliberately:

    git push --no-verify

MSG
    exit 1
  fi

  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || echo "$local_sha")
  else
    base=$remote_sha
  fi
  if git diff --name-only "$base" "$local_sha" | grep -q '^30-tools/\(html-to-pdf\|rua-desk\|rua-vault\|rua-seat\)/'; then
    run_tools_check=1
  fi
done

if [ "$run_tools_check" = 1 ]; then
  "$root/00-system/check-tools.sh" || exit 1
fi

exit 0
