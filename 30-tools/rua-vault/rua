#!/usr/bin/env python3
"""Deliberate external vault retrieval. No ambient search."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import sys
import tempfile
import unicodedata
from urllib.parse import unquote, urlparse

EXIT_OK = 0
EXIT_MISSING = 1
EXIT_INVALID = 2
EXIT_VAULT = 3
EXIT_SOURCE = 4
EXIT_RECORD = 5
MAX_BYTES = 1_048_576
MAX_RECORD_BYTES = 16 * MAX_BYTES
REF_CHARS = set("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.")


class VaultError(Exception):
    def __init__(self, code: int, message: str, reason: str | None = None):
        self.code = code
        self.message = message
        self.reason = reason or message.rstrip(".").lower().replace(" ", "_")
        super().__init__(message)


def fail(code: int, message: str, reason: str | None = None) -> None:
    raise VaultError(code, message, reason)


def default_manifest() -> Path:
    xdg = os.environ.get("XDG_CONFIG_HOME")
    base = Path(xdg) if xdg else Path.home() / ".config"
    return base / "rua" / "vault" / "manifest.json"


def manifest_path() -> Path:
    override = os.environ.get("RUA_VAULT_MANIFEST")
    return Path(override) if override else default_manifest()


def inside_git(path: Path) -> bool:
    current = path if path.is_dir() else path.parent
    for parent in [current, *current.parents]:
        if (parent / ".git").exists():
            return True
    return False


def lstat_or_none(path: Path):
    try:
        return path.lstat()
    except OSError:
        return None


def load_manifest() -> dict:
    path = manifest_path()
    info = lstat_or_none(path)
    if info is None or not stat.S_ISREG(info.st_mode):
        fail(EXIT_VAULT, "Vault unavailable.")
    if stat.S_ISLNK(info.st_mode) or path.is_symlink():
        fail(EXIT_VAULT, "Vault unavailable.")
    if info.st_mode & (stat.S_IRWXG | stat.S_IRWXO):
        fail(EXIT_VAULT, "Vault unavailable.")
    parent = path.parent
    parent_info = lstat_or_none(parent)
    if parent_info is None or parent_info.st_mode & (stat.S_IRWXG | stat.S_IRWXO):
        fail(EXIT_VAULT, "Vault unavailable.")
    if inside_git(path.resolve()):
        fail(EXIT_VAULT, "Vault unavailable.")
    try:
        raw = path.read_bytes()
        data = json.loads(raw.decode("utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        fail(EXIT_VAULT, "Vault unavailable.")
    if not isinstance(data, dict) or data.get("version") != 1:
        fail(EXIT_VAULT, "Vault unavailable.")
    entries = data.get("entries")
    if not isinstance(entries, list):
        fail(EXIT_VAULT, "Vault unavailable.")
    seen = set()
    cleaned = []
    required = ("ref", "label", "aliases", "uri", "sha256")
    for entry in entries:
        if not isinstance(entry, dict) or any(key not in entry for key in required):
            fail(EXIT_VAULT, "Vault unavailable.")
        ref = entry["ref"]
        if not isinstance(ref, str) or not ref or any(ch not in REF_CHARS for ch in ref):
            fail(EXIT_VAULT, "Vault unavailable.")
        if ref in seen:
            fail(EXIT_VAULT, "Vault unavailable.")
        seen.add(ref)
        if not isinstance(entry["label"], str):
            fail(EXIT_VAULT, "Vault unavailable.")
        aliases = entry["aliases"]
        if not isinstance(aliases, list) or any(not isinstance(item, str) for item in aliases):
            fail(EXIT_VAULT, "Vault unavailable.")
        if not isinstance(entry["uri"], str) or not isinstance(entry["sha256"], str):
            fail(EXIT_VAULT, "Vault unavailable.")
        cleaned.append(entry)
    return {"version": 1, "entries": cleaned}


def fold(text: str) -> str:
    return unicodedata.normalize("NFKC", text).casefold()


def search_entries(entries: list, query: str) -> list:
    needle = fold(query)
    matches = []
    for entry in entries:
        haystacks = [entry["label"], *entry["aliases"]]
        if any(needle in fold(item) for item in haystacks):
            matches.append(entry)
    matches.sort(key=lambda item: (fold(item["label"]), item["ref"]))
    return matches


def file_from_uri(uri: str) -> Path:
    try:
        parsed = urlparse(uri)
    except ValueError:
        fail(EXIT_SOURCE, "Source unavailable.", "unsupported_uri")
    if (parsed.scheme != "file" or parsed.netloc not in ("", "localhost")
            or parsed.query or parsed.fragment or "\x00" in unquote(parsed.path)):
        fail(EXIT_SOURCE, "Source unavailable.", "unsupported_uri")
    if not parsed.path.startswith("/"):
        fail(EXIT_SOURCE, "Source unavailable.")
    path = Path(unquote(parsed.path))
    if os.name == "nt" and path.parts and path.parts[0] == "/":
        path = Path(path.as_posix().lstrip("/"))
    return path


def read_payload(entry: dict, max_bytes: int = MAX_BYTES) -> bytes:
    path = file_from_uri(entry["uri"])
    info = lstat_or_none(path)
    if info is None:
        fail(EXIT_SOURCE, "Source unavailable.", "missing_or_unreadable")
    if stat.S_ISLNK(info.st_mode) or path.is_symlink():
        fail(EXIT_SOURCE, "Source unavailable.", "symlink")
    if not stat.S_ISREG(info.st_mode):
        fail(EXIT_SOURCE, "Source unavailable.", "not_regular_file")
    if info.st_mode & (stat.S_IRWXG | stat.S_IRWXO) or not info.st_mode & stat.S_IRUSR:
        fail(EXIT_SOURCE, "Source unavailable.", "insecure_or_unreadable_permissions")
    if info.st_size > max_bytes:
        fail(EXIT_SOURCE, "Record exceeds read limit. Use --max-bytes and --lines.", "read_limit_exceeded")
    try:
        resolved = path.resolve()
    except OSError:
        fail(EXIT_SOURCE, "Source unavailable.")
    if inside_git(resolved):
        fail(EXIT_SOURCE, "Source unavailable.", "inside_git")
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
                     | getattr(os, "O_NONBLOCK", 0))
    except OSError:
        fail(EXIT_SOURCE, "Source unavailable.")
    try:
        opened = os.fstat(fd)
        if (not stat.S_ISREG(opened.st_mode)
                or (opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino)
                or opened.st_mode & (stat.S_IRWXG | stat.S_IRWXO)
                or not opened.st_mode & stat.S_IRUSR):
            fail(EXIT_SOURCE, "Source unavailable.", "source_changed_or_insecure")
        chunks = []
        remaining = max_bytes + 1
        while remaining:
            chunk = os.read(fd, min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        data = b"".join(chunks)
    except OSError:
        fail(EXIT_SOURCE, "Source unavailable.", "missing_or_unreadable")
    finally:
        os.close(fd)
    if len(data) > max_bytes:
        fail(EXIT_SOURCE, "Record exceeds read limit. Use --max-bytes and --lines.", "read_limit_exceeded")
    digest = hashlib.sha256(data).hexdigest()
    if digest != entry["sha256"]:
        fail(EXIT_RECORD, "Record invalid.")
    return data


def decode_payload(data: bytes) -> str:
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        fail(EXIT_RECORD, "Record invalid.", "invalid_utf8")


def read_raw_file(path: Path, max_bytes: int = MAX_RECORD_BYTES) -> bytes:
    """Read a file with security checks but without SHA verification."""
    info = lstat_or_none(path)
    if info is None:
        fail(EXIT_SOURCE, "Source unavailable.", "missing_or_unreadable")
    if stat.S_ISLNK(info.st_mode) or path.is_symlink():
        fail(EXIT_SOURCE, "Source unavailable.", "symlink")
    if not stat.S_ISREG(info.st_mode):
        fail(EXIT_SOURCE, "Source unavailable.", "not_regular_file")
    if info.st_mode & (stat.S_IRWXG | stat.S_IRWXO) or not info.st_mode & stat.S_IRUSR:
        fail(EXIT_SOURCE, "Source unavailable.", "insecure_or_unreadable_permissions")
    if info.st_size > max_bytes:
        fail(EXIT_SOURCE, "Record exceeds read limit.", "read_limit_exceeded")
    try:
        resolved = path.resolve()
    except OSError:
        fail(EXIT_SOURCE, "Source unavailable.")
    if inside_git(resolved):
        fail(EXIT_SOURCE, "Source unavailable.", "inside_git")
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
                     | getattr(os, "O_NONBLOCK", 0))
    except OSError:
        fail(EXIT_SOURCE, "Source unavailable.")
    try:
        chunks: list[bytes] = []
        remaining = max_bytes + 1
        while remaining:
            chunk = os.read(fd, min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        data = b"".join(chunks)
    except OSError:
        fail(EXIT_SOURCE, "Source unavailable.", "missing_or_unreadable")
    finally:
        os.close(fd)
    if len(data) > max_bytes:
        fail(EXIT_SOURCE, "Record exceeds read limit.", "read_limit_exceeded")
    return data


def write_manifest_atomic(path: Path, data: dict) -> None:
    """Write manifest JSON atomically, preserving owner-only permissions."""
    raw = json.dumps(data, indent=2).encode("utf-8") + b"\n"
    parent = path.parent
    fd, tmp_path = tempfile.mkstemp(dir=parent, prefix=".manifest-")
    try:
        os.chmod(tmp_path, stat.S_IRUSR | stat.S_IWUSR)
        os.write(fd, raw)
        os.fsync(fd)
        os.close(fd)
        fd = -1
        os.replace(tmp_path, path)
        tmp_path = None
    finally:
        if fd >= 0:
            os.close(fd)
        if tmp_path is not None:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass


def version_key(stem: str) -> tuple[str, int] | None:
    """
    Return (base, version_number) if stem ends with a version suffix
    like -v3, _v3, -3, _3. Return None if no version found.
    """
    m = re.match(r"^(.*?)[-_]v?(\d+)$", stem, re.IGNORECASE)
    if m:
        return m.group(1), int(m.group(2))
    return None


def cmd_rehash(args: argparse.Namespace) -> None:
    ref = args.ref
    if not ref or any(ch not in REF_CHARS for ch in ref):
        fail(EXIT_INVALID, "Invalid command.")
    manifest = load_manifest()
    entries = manifest["entries"]
    idx = next((i for i, e in enumerate(entries) if e["ref"] == ref), None)
    if idx is None:
        fail(EXIT_MISSING, "Record missing.")
    entry = entries[idx]
    path = file_from_uri(entry["uri"])
    data = read_raw_file(path)
    new_sha = hashlib.sha256(data).hexdigest()
    old_sha = entry["sha256"]
    if new_sha == old_sha:
        print(f"{ref}\tok\tsha256 already current")
        return
    entries[idx] = {**entry, "sha256": new_sha}
    mpath = manifest_path()
    write_manifest_atomic(mpath, {"version": 1, "entries": entries})
    print(f"{ref}\tupdated\told={old_sha[:16]}  new={new_sha[:16]}")


def cmd_tidy(args: argparse.Namespace) -> None:
    scan_path = Path(args.path).expanduser().resolve()
    if not scan_path.is_dir():
        fail(EXIT_INVALID, "Invalid command.")

    # Group files by (base_without_version): collect (version_int, path) per group.
    clusters: dict[str, list[tuple[int, Path]]] = {}
    singletons: list[Path] = []

    for child in sorted(scan_path.iterdir()):
        if not child.is_file() or child.name.startswith("."):
            continue
        parsed = version_key(child.stem)
        if parsed is None:
            singletons.append(child)
            continue
        base, ver = parsed
        group_key = f"{base}\x00{child.suffix}"
        clusters.setdefault(group_key, []).append((ver, child))

    # Find groups with more than one version.
    multi = {k: v for k, v in clusters.items() if len(v) > 1}

    if not multi:
        if args.json:
            print(json.dumps({"clusters": []}))
        else:
            print("No version clusters found.")
        return

    results = []
    to_delete: list[Path] = []

    for group_key, members in sorted(multi.items()):
        members.sort(key=lambda x: x[0])
        newest_ver, newest_path = members[-1]
        stale = [p for (v, p) in members if v != newest_ver]
        results.append({
            "keep": str(newest_path.name),
            "stale": [str(p.name) for p in stale],
        })
        to_delete.extend(stale)

    if args.json:
        deleted = []
        if args.delete:
            for p in to_delete:
                p.unlink()
                deleted.append(str(p.name))
        print(json.dumps({"clusters": results, "deleted": deleted}))
        return

    for r in results:
        print(f"keep    {r['keep']}")
        for s in r["stale"]:
            marker = "DELETE" if args.delete else "stale "
            print(f"  {marker}  {s}")
    print()
    if args.delete:
        for p in to_delete:
            p.unlink()
        print(f"Deleted {len(to_delete)} file(s).")
    else:
        print(f"{len(to_delete)} stale file(s). Re-run with --delete to remove.")


def line_range(value: str) -> tuple[int, int]:
    try:
        start, end = (int(part) for part in value.split(":"))
        if not 1 <= start <= end:
            raise ValueError
    except ValueError:
        fail(EXIT_INVALID, "Invalid command.")
    return start, end


def cmd_check(args: argparse.Namespace) -> None:
    entries = load_manifest()["entries"]
    if args.ref:
        entries = [entry for entry in entries if entry["ref"] == args.ref]
        if not entries:
            fail(EXIT_MISSING, "Record missing.")
    results = []
    for entry in entries:
        try:
            data = read_payload(entry, MAX_RECORD_BYTES)
            decode_payload(data)
            reason = "requires_explicit_limit_and_slice" if len(data) > MAX_BYTES else "verified"
            result = {"ref": entry["ref"], "status": "ok", "reason": reason}
        except VaultError as error:
            result = {"ref": entry["ref"], "status": "error", "reason": error.reason}
        results.append(result)
    if args.json:
        print(json.dumps({"records": results}))
    else:
        for result in results:
            print(f"{result['ref']}\t{result['status']}\t{result['reason']}")
    if any(result["status"] == "error" for result in results):
        raise VaultError(EXIT_SOURCE, "Vault check found inaccessible records.")


def cmd_search(args: argparse.Namespace) -> None:
    query = args.query
    if len(query.strip()) < 3:
        fail(EXIT_INVALID, "Invalid command.")
    entries = load_manifest()["entries"]
    matches = search_entries(entries, query)
    if not matches:
        fail(EXIT_MISSING, "Record missing.")
    if args.json:
        print(json.dumps({"matches": [{"ref": m["ref"], "label": m["label"]} for m in matches]}))
        return
    for match in matches:
        print(f"{match['ref']}\t{match['label']}")


def cmd_get(args: argparse.Namespace) -> None:
    if not 1 <= args.max_bytes <= MAX_RECORD_BYTES:
        fail(EXIT_INVALID, "Invalid command.")
    ref = args.ref
    if not ref or any(ch not in REF_CHARS for ch in ref):
        fail(EXIT_INVALID, "Invalid command.")
    entries = load_manifest()["entries"]
    found = next((item for item in entries if item["ref"] == ref), None)
    if found is None:
        fail(EXIT_MISSING, "Record missing.")
    data = read_payload(found, args.max_bytes)
    text = decode_payload(data)
    if args.lines:
        start, end = args.lines
        lines = text.splitlines(keepends=True)
        if end > len(lines):
            fail(EXIT_INVALID, "Line range is outside the record.")
        text = "".join(lines[start - 1:end])
    elif args.chars:
        start, end = args.chars
        if end > len(text):
            fail(EXIT_INVALID, "Character range is outside the record.")
        text = text[start - 1:end]
    if len(text.encode("utf-8")) > MAX_BYTES:
        fail(EXIT_SOURCE, "Output exceeds 1 MiB. Use a smaller --lines or --chars range.")
    if args.json:
        result = {
            "ref": found["ref"], "label": found["label"],
            "sha256": found["sha256"], "content": text,
        }
        if args.lines:
            result["lines"] = {"start": args.lines[0], "end": args.lines[1]}
        elif args.chars:
            result["chars"] = {"start": args.chars[0], "end": args.chars[1]}
        print(json.dumps(result))
        return
    sys.stdout.write(text)


def silent_error(_message: str) -> None:
    fail(EXIT_INVALID, "Invalid command.")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="rua")
    parser.error = silent_error
    sub = parser.add_subparsers(dest="group")
    vault = sub.add_parser("vault")
    vault.error = silent_error
    vault_sub = vault.add_subparsers(dest="action")
    search = vault_sub.add_parser("search")
    search.error = silent_error
    search.add_argument("--json", action="store_true")
    search.add_argument("query")
    search.set_defaults(func=cmd_search)
    get_cmd = vault_sub.add_parser("get")
    get_cmd.error = silent_error
    get_cmd.add_argument("--json", action="store_true")
    get_cmd.add_argument("--max-bytes", type=int, default=MAX_BYTES,
                         help="verified source read limit, 1 to 16777216 bytes (default: 1048576)")
    selection = get_cmd.add_mutually_exclusive_group()
    selection.add_argument("--lines", type=line_range, help="inclusive 1-based START:END, verified before slicing")
    selection.add_argument("--chars", type=line_range, help="inclusive 1-based Unicode character START:END, for long lines")
    get_cmd.add_argument("ref")
    get_cmd.set_defaults(func=cmd_get)
    check = vault_sub.add_parser("check", help="verify records; print refs and health only")
    check.error = silent_error
    check.add_argument("--json", action="store_true")
    check.add_argument("ref", nargs="?")
    check.set_defaults(func=cmd_check)
    rehash = vault_sub.add_parser("rehash", help="recompute sha256 for a record and update the manifest")
    rehash.error = silent_error
    rehash.add_argument("ref")
    rehash.set_defaults(func=cmd_rehash)
    tidy = vault_sub.add_parser("tidy", help="show (and optionally delete) stale versioned files in a directory")
    tidy.error = silent_error
    tidy.add_argument("path", help="directory to scan")
    tidy.add_argument("--delete", action="store_true", help="delete stale versions (dry-run by default)")
    tidy.add_argument("--json", action="store_true")
    tidy.set_defaults(func=cmd_tidy)
    return parser


def main(argv: list[str] | None = None) -> None:
    parser = build_parser()
    try:
        args = parser.parse_args(argv)
        if getattr(args, "func", None) is None:
            fail(EXIT_INVALID, "Invalid command.")
        args.func(args)
    except VaultError as error:
        print(error.message, file=sys.stderr)
        raise SystemExit(error.code)


if __name__ == "__main__":
    main()
